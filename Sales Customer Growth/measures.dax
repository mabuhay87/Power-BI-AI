Revenue = SUM(Orders[Revenue])
Gross Profit = SUM(Orders[GrossProfit])
Gross Margin % = DIVIDE([Gross Profit], [Revenue])
Orders = DISTINCTCOUNT(Orders[OrderKey])
Customers = DISTINCTCOUNT(Orders[CustomerKey])
Average Order Value = DIVIDE([Revenue], [Orders])
Prior Year Revenue = CALCULATE([Revenue], DATEADD('Date'[Date], -1, YEAR))
YoY Revenue Growth = DIVIDE([Revenue] - [Prior Year Revenue], [Prior Year Revenue])
High Churn Customers = CALCULATE(COUNTROWS(CustomerPredictions), CustomerPredictions[ChurnRisk] = "High")
Revenue at Risk = CALCULATE(SUM(CustomerPredictions[LifetimeRevenue]), CustomerPredictions[ChurnRisk] = "High")
Average Churn Probability = AVERAGE(CustomerPredictions[ChurnProbability])
