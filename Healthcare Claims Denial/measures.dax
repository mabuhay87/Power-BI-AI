Total Claims = COUNTROWS(Claims)
Total Billed = SUM(Claims[BilledAmount])
Total Paid = SUM(Claims[PaidAmount])
Denied Claims = CALCULATE([Total Claims], Claims[DeniedFlag] = 1)
Denial Rate = DIVIDE([Denied Claims], [Total Claims])
Denied Dollars = CALCULATE([Total Billed], Claims[DeniedFlag] = 1)
Predicted High Risk Claims = CALCULATE([Total Claims], Predictions[RiskBand] = "High")
High Risk Billed = CALCULATE([Total Billed], Predictions[RiskBand] = "High")
Preventable Denials = CALCULATE([Denied Claims], Claims[DenialReason] IN {"Missing Authorization", "Timely Filing", "Coding Error"})
Preventable Denial Rate = DIVIDE([Preventable Denials], [Denied Claims])
Average Denial Probability = AVERAGE(Predictions[DenialProbability])
