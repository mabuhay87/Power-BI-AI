Demand Units = SUM(InventoryDaily[DemandUnits])
On Hand Units = SUM(InventoryDaily[OnHandUnits])
Inbound Units = SUM(InventoryDaily[InboundUnits])
Stockout Events = SUM(InventoryDaily[StockoutFlag])
Stockout Rate = DIVIDE([Stockout Events], COUNTROWS(InventoryDaily))
High Risk SKU Locations = CALCULATE(COUNTROWS(StockoutPredictions), StockoutPredictions[RiskBand] = "High")
Recommended Reorder Units = SUM(StockoutPredictions[RecommendedReorderUnits])
Average Stockout Probability = AVERAGE(StockoutPredictions[StockoutProbability])
Inventory Value = SUMX(InventoryDaily, InventoryDaily[OnHandUnits] * RELATED(Products[UnitCost]))
